# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key for the summary step (stage 3). Without it, template summaries are used.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: use a local Ollama model instead of the Anthropic API
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_HOST=http://localhost:11434
